# AI keys (all free tier, no credit card)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Supabase (free tier) — project already exists; service key stays on the backend
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Watched assets
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
SCALP_SYMBOLS=BTCUSDT,ETHUSDT
SCALP_FUTURES_SYMBOLS=XAUUSDT,XAGUSDT
STOCK_SYMBOLS=AAPL,TSLA,MSFT,NVDA
FOREX_SYMBOLS=EURUSD=X,GBPUSD=X,USDJPY=X
COMMODITY_SYMBOLS=GC=F,CL=F,SI=F
INDEX_SYMBOLS=^GSPC,^IXIC,^DJI

# Cycle config
PREDICTION_INTERVAL_MINUTES=15
VERIFICATION_WINDOW_MINUTES=15

# Graduation (MEASUREMENT_FIX ladder; old confidence gate is retired)
GRAD_Z=2.33
MAX_DD_R=30
MARKOV_K=1.0

# Costs (fractions of price, per side)
FEE_SPOT_TAKER=0.0010
FEE_SPOT_MAKER=0.0010
FEE_FUT_TAKER=0.0005
FEE_FUT_MAKER=0.0002
FEE_OTHER=0.0003
SLIPPAGE_PCT=0.0001
SCALP_FEE_MODE=taker
MIN_REWARD_COST_RATIO=3.0
MAX_BREAKEVEN_WR=0.50
# Set true only after the operator confirms the Binance fee page for XAU/XAG
METAL_FEE_CONFIRMED=

# Scalp
SCALP_RR=1.5
SCALP_QUICK_MAX_MIN=15
SCALP_EXT_MAX_MIN=60
MIN_SIGNAL_SCORE=4.5
MIN_VOL_RATIO=0.6
SCALP_HOURS=24/7
BT_ASSUMED_SPREAD_PCT=0.0001

# MetaTrader 5 (optional — blank disables)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Phase 2 flags (ALL false in Phase 1)
ENABLE_VECTOR_SEARCH=false
ENABLE_INVERSE_SEARCH=false
ENABLE_BROWSER_VERIFY=false
ENABLE_SUGGESTIONS=false
ENABLE_TRADE_EXECUTION=false
